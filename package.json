{
	"name": "utsuwa",
	"version": "0.20.2",
	"packageManager": "pnpm@10.28.2",
	"description": "An open-source VRM avatar companion app with AI chat, voice, memory, and relationship mechanics",
	"author": "Juice Boxx Games LLC",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"node": ">=22.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JuiceBoxxGames/utsuwa.git"
	},
	"bugs": {
		"url": "https://github.com/JuiceBoxxGames/utsuwa/issues"
	},
	"homepage": "https://github.com/JuiceBoxxGames/utsuwa#readme",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "pagefind --site .vercel/output/static || pagefind --site .svelte-kit/cloudflare || pagefind --site build || echo 'Pagefind indexing skipped (no static HTML found)'",
		"cf:deploy": "wrangler deploy cloudflare-worker.js",
		"cf:preview": "wrangler versions upload cloudflare-worker.js",
		"preview": "vite preview",
		"prepare": "(paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync) || echo ''",
		"lint": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
		"test:browser": "playwright test"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "2.25.4",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.18",
		"@tauri-apps/api": "~2.12.1",
		"@tauri-apps/cli": "^2.12.1",
		"@tauri-apps/plugin-fs": "~2.6.0",
		"@tauri-apps/plugin-global-shortcut": "~2.4.0",
		"@types/three": "^0.182.0",
		"mdsvex": "^0.12.6",
		"pagefind": "^1.4.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^3.21.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"wrangler": "^4.143.1"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@huggingface/transformers": "^3.8.1",
		"@lucide/svelte": "^1.47.0",
		"@pixiv/three-vrm": "^3.4.5",
		"@pixiv/three-vrm-animation": "^3.4.5",
		"@tauri-apps/plugin-http": "~2.8.0",
		"@tauri-apps/plugin-opener": "~2.7.0",
		"@tauri-apps/plugin-process": "~2.4.0",
		"@tauri-apps/plugin-updater": "~2.13.1",
		"@threlte/core": "^8.3.1",
		"@threlte/xr": "^1.6.1",
		"@xsai/stream-text": "^0.4.2",
		"bits-ui": "^2.15.4",
		"dexie": "^4.0.11",
		"eld": "^2.0.3",
		"force-graph": "^1.51.0",
		"localforage": "^1.10.0",
		"three": "^0.182.0"
	}
}
