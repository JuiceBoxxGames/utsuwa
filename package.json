	"description": "An open-source VRM avatar companion app with AI chat, voice, memory, and relationship mechanics",
	"author": "Juice Boxx Games LLC",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"node": ">=22.0.0"
	},
