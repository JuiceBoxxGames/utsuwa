# MCP tool endpoints (web/server builds). Off by default. Only enable on
# deployments you control, since stdio servers run local commands and the
# /api/mcp/* routes are unauthenticated: put an authenticating reverse proxy
# in front of any shared deployment.
# Values: unset/off (disabled), server (active), client/both (reserved)
# MCP_ENABLED=server
# Prompt hardening is on by default; set to false to drop it. Tools listed in
# PUBLIC_MCP_CONFIRM_TOOLS never run at all (web runtime / build-time on desktop):
# PUBLIC_MCP_PROMPT_HARDENING=false
# PUBLIC_MCP_CONFIRM_TOOLS=unlock_door,set_alarm
# stdio is disabled until allowlisted. Each comma-separated entry is a full
# command line; a request must match it exactly. End an entry with * to allow
# extra arguments after it. A bare * allows anything (throwaway single-user
# setups only).
# MCP_STDIO_ALLOWED_COMMANDS=npx -y @brave/brave-search-mcp-server,npx -y mcp-searxng
# Env vars a stdio server config may set; all others are dropped:
# MCP_STDIO_ENV_ALLOWLIST=BRAVE_API_KEY,SEARXNG_URL

# Lets the server proxy chat, model discovery, and local TTS to private hosts.
# Never set this on a public deployment: it opens your network to anyone who can reach the server.
# ALLOW_LOCAL_PROVIDER_HOSTS=true
